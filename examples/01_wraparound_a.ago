des finderum(les, ses) {
    rerum := []
    ba := 0
    ea := 0
    dum ea < lerum.a() {
        si ses == les[ea] {
            si ba < ea {
                rerum.inseri(rerum.a(), les[ba.<ea])
            }
            ba = ea + 1
        }
        ea = ea + 1
    }
    si ba < ea {
        rerum.inseri(rerum.a(), les[ba.<ea])
    }
    redeo rerum
}

numaem := apertu("./a.txt").contentes.finderum("\n").mutatuum(des {
        res := ides
        res[0] = ides[0] == "L" ? "-" : "+"
        redeo ra
})

va := 50
ca := 0
pro numa in numaem {
    va = (va + numa) % 100
    ca = ca + (non vam).a()
}

ces.dici()
