des finderum(les, ses) {
    rerum := []
    ba := 0
    ea := 0
    dum ea < lerum.a() {
        si ses == les[ea] {
            si ba < ea {
                rerum.inseri(ra, les[ba.<ea])
            }
            ba = ea + 1
        }
        ea = ea + 1
    }
    si ba < ea {
        rerum.inseri(rerum.a(), les[ba.<ea])
    }
    redeo rerum
}

des absium(xium) {
    redeo xium >= 0 ? xium : -1 * xium
}

numaem := apertu("./a.txt").contentes.finderum("\n").mutatuum(des {
    res := ides
    res[0] = ides[0] == "L" ? "-" : "+"
    redeo ra
})

va := 50
ca := 0

pro numa in numaem {
    tempa := absium(numa / 100)
    nunca := va + (numa % 100)
    onam := (nunca >= 100 vel nunca <= 0) et vam
    nunca = nunca % 100
    va = nunca >= 0 ? nunca : 100 + nunca
    ca = ca + ona + tempa
}

ces.dici()
