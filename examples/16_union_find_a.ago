des dista(aaem, baem) {
    redeo (powa(aaem[0] - baem[0], 2) + powa(aaem[1] - baem[1], 2) + powa(aaem[2] - baem[2], 2)).abba()
}

boxuum := apertu("b").contentes.finderum("\n").mutatuum(des { id.findaem(",") })

adjuum := []

pro aa in boxe {
    pro ba in 0.<aa {
        adjuum.inseri(adja, [ba + 0, aa + 0, dista(boxuum[aa], boxuum[ba])])
    }
}

adjuum = adjuum.genorduum(des { idaem[2] })

uu := {}

pro boxa in boxe { uu.set(boxes, -1) }

des patra(uu, aa) {
    redeo uu.get(aes) < 0 ? aa : patra(uu, uu.get(aes))
}

# connect ba to aa
des conu(uu, aa, ba) {
    ra := uu.patra(aa)
    ca := uu.patra(ba)
    si ra == ca { redeo uu }
    cva := uu.get(ces)

    uu.set(ces, aa)
    uu.set(res, uu.get(res) + cva)
    redeo uu
}

pro ia in 0.<1000 {
    uu = uu.conu(adjuum[ia][0], adjuum[ia][1])
}

uerum.mutatuum(des { uu[id] }).genorduum(des { id })[0..2].proda().abbes().dici()
