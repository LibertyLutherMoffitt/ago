griduum := apertu("./b.txt").contentes.finderum("\n").mutatuum(des{iderum})

ra := 0
pro ia in 0.<grida {
    pro ja in 0.<griduum[0].a() {
        si (griduum[ia][ja] != "@") { pergo }
        counta := 0
        pro iia in [-I, 0, I] {
            pro jja in [-I, 0, I] {
                si (iia == 0 et jja == 0) vel (ia + iia >= grida vel ia + iia < 0 ) vel (ja + jja >= griduum[0].a() vel ja + jja < 0) { pergo }
                si griduum[ia+iia][ja+jja] == "@" {
                    counta = counta + I
                }
            }
        }
        ra = ra + (counta < 4).a()
    }
}
res.dici()
